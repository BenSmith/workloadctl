FROM registry.fedoraproject.org/fedora:43

RUN dnf install --setopt=install_weak_deps=False --nodocs -y \
    samba \
    shadow-utils \
    && dnf clean all

RUN mkdir -p /exports

COPY --link --chmod=0755 entrypoint.sh /entrypoint.sh
COPY --link --chmod=0755 smb-users /usr/local/bin/smb-users

EXPOSE 445

CMD ["/entrypoint.sh"]
