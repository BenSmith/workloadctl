#!/usr/bin/env bash
# moatery's newest RPM in REPO, the Forgejo RPM registry its main publishes
# to, to DEST. The homelab's images ship this moatery beside main's
# workloadctl, so the Forgejo workflows test against it.
#
# The registry signs its metadata, not its packages: dnf refuses metadata
# the registry's key (.forgejo/rpm-registry.gpg) did not sign, and a package
# whose checksum is not the one the metadata names.
#
#   .forgejo/scripts/forge-moatery-rpm "$SERVER/api/packages/$OWNER/rpm" DEST
set -euo pipefail
[ "$#" -eq 2 ] || { echo "usage: $0 REPO DEST" >&2; exit 2; }
repo=$1
dest=$2
key=$(realpath "$(dirname "$(realpath "$0")")/../rpm-registry.gpg")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# A repository dnf cannot load is otherwise skipped, and then holds nothing.
dnf download -y -q --refresh --arch=noarch --destdir="$work/rpms" \
  --repofrompath="forge,$repo" --repo=forge \
  --setopt=forge.skip_if_unavailable=0 \
  --setopt=forge.repo_gpgcheck=1 --setopt=forge.gpgcheck=0 \
  --setopt=forge.gpgkey="file://$key" moatery
set -- "$work"/rpms/*.rpm
if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
  echo "expected exactly one moatery RPM in $repo, got $#" >&2
  exit 1
fi
install -m 0644 "$1" "$dest"
rpm -qp "$dest"
